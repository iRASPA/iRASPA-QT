# Maintainer: David Dubbeldam <d.dubbeldam@uva.nl>
pkgname=iraspa
pkgver=2.3.7
pkgrel=1
pkgdesc="Molecular visualizer/editor"
arch=('x86_64' 'aarch64')
url="https://www.iraspa.org"
license=('GPL3')
makedepends=(
        'cmake' 'ninja' 'pkgconf'
        'qt6-base' 'qt6-tools'
        'vulkan-headers' 'vulkan-icd-loader' 'glslang' 'libxcb'
        'opencl-headers' 'ocl-icd' 'python' 'ffmpeg' 'zlib' 'xz'
)
depends=(
        'qt6-base' 'vulkan-icd-loader' 'libxcb'
        'ocl-icd' 'zlib' 'xz' 'python' 'ffmpeg'
)
source=(iraspa.tar.gz)
md5sums=('SKIP')

build() {
        cmake -B build --preset linux-arch -DIRASPA_VERSION="${pkgver}"
        cmake --build build
}

package() {
        DESTDIR="${pkgdir}" cmake --install build
}
